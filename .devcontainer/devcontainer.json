{
  "name": "PearlMind learning room",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y libgomp1 && python -m pip install -e '.[ci,api,learning]'",
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "Local teaching API", "onAutoForward": "notify" },
    "8080": { "label": "PearlMind learning site", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"]
      }
    }
  },
  "remoteUser": "vscode"
}
